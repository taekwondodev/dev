{
  "name": "dev-pi-environment",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "dev": "src/launcher.ts"
  },
  "type": "module",
  "scripts": {
    "dev": "node src/launcher.ts",
    "dev:profile": "node src/launcher.ts --profile",
    "dev:save-profile": "node src/launcher.ts --save-profile",
    "dev:diagnostics": "node src/launcher.ts --diagnostics",
    "dev:probe": "node src/launcher.ts --probe-runtime",
    "dev:continue": "node src/launcher.ts --continue",
    "dev:resume": "node src/launcher.ts --resume",
    "dev:help": "node src/launcher.ts --help",
    "start": "node src/launcher.ts",
    "diagnostics": "node src/launcher.ts --diagnostics",
    "check": "node tests/run-checks.ts",
    "smoke": "node tests/run-checks.ts smoke",
    "cleanup:check": "node tests/run-checks.ts cleanup:check",
    "workspace:check": "node tests/run-checks.ts workspace:check",
    "workspace:tui": "node tests/run-checks.ts workspace:tui",
    "workspace:github": "node tests/run-checks.ts workspace:github",
    "web:check": "node tests/run-checks.ts web:check",
    "work:check": "node tests/run-checks.ts work:check",
    "orb:check": "node tests/run-checks.ts orb:check",
    "setup": "node scripts/maintain.ts setup",
    "update": "node scripts/maintain.ts update",
    "rollback": "node scripts/maintain.ts rollback",
    "profile": "node scripts/maintain.ts profile",
    "upgrade": "node scripts/maintain.ts update",
    "pi:update": "node scripts/maintain.ts pi-update",
    "profile:check": "node tests/run-checks.ts profile:check",
    "types:pi": "node scripts/resolve-pi.ts",
    "typecheck": "npm run types:pi && tsc --noEmit",
    "lint:effect": "npm run types:pi && effect-tsgo diagnostics --project tsconfig.json --strict --format text",
    "lint:types": "npm run types:pi && oxlint -c .oxlintrc-type-aware.json --max-warnings=0 .",
    "lint": "npm run typecheck && npm run lint:effect && npm run lint:types && oxlint --max-warnings=0 .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@effect/platform-node": "4.1.2",
    "@effect/platform-node-shared": "4.1.2",
    "@mozilla/readability": "0.6.0",
    "effect": "4.1.2",
    "linkedom": "0.18.15"
  },
  "devDependencies": {
    "@effect/tsgo": "0.63.0",
    "@types/node": "26.6.6",
    "oxc-standard": "^1.4.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.1.2"
  },
  "config": {
    "pi": "1.5.0"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
