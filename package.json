{
  "name": "dev-pi-environment",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "dev": "src/launcher.ts"
  },
  "type": "module",
  "scripts": {
    "dev": "node src/launcher.ts",
    "dev:general": "node src/launcher.ts --profile general",
    "dev:apple": "node src/launcher.ts --profile apple",
    "dev:save:general": "node src/launcher.ts --save-profile general",
    "dev:save:apple": "node src/launcher.ts --save-profile apple",
    "dev:diagnostics": "node src/launcher.ts --diagnostics",
    "dev:probe": "node src/launcher.ts --probe-runtime",
    "dev:continue": "node src/launcher.ts --continue",
    "dev:resume": "node src/launcher.ts --resume",
    "dev:help": "node src/launcher.ts --help",
    "start": "node src/launcher.ts",
    "diagnostics": "node src/launcher.ts --diagnostics",
    "smoke": "node scripts/smoke.ts",
    "workspace:check": "npm run types:pi && node scripts/workspace-authority-check.ts && node scripts/workspace-release-check.ts && node scripts/workspace-process-check.ts && node scripts/workspace-host-contract-check.ts && node scripts/workspace-host-session-check.ts && node scripts/workspace-launcher-check.ts",
    "workspace:tui": "npm run types:pi && python3 scripts/run-workspace-pty-probes.py",
    "workspace:github": "npm run types:pi && node scripts/workspace-github-reader-check.ts",
    "setup": "node scripts/maintain.ts setup",
    "update": "node scripts/maintain.ts update",
    "rollback": "node scripts/maintain.ts rollback",
    "types:pi": "node scripts/resolve-pi.ts",
    "typecheck": "npm run types:pi && tsc --noEmit",
    "lint:effect": "npm run types:pi && effect-tsgo diagnostics --project tsconfig.json --strict --format text",
    "lint": "npm run typecheck && npm run lint:effect && oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.115",
    "@effect/platform-node-shared": "4.0.0-rc.115",
    "effect": "4.0.0-rc.115"
  },
  "devDependencies": {
    "@effect/tsgo": "0.45.0",
    "@types/node": "22.20.4",
    "oxc-standard": "^1.4.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.83.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.115"
  },
  "engines": {
    "node": ">=22.23.2"
  }
}
