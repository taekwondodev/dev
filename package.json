{
  "name": "dev-pi-environment",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "dev": "bin/dev.mjs"
  },
  "type": "module",
  "scripts": {
    "dev": "node bin/dev.mjs",
    "dev:general": "node bin/dev.mjs --specialization general",
    "dev:apple": "node bin/dev.mjs --specialization apple",
    "dev:save:general": "node bin/dev.mjs --save-specialization general",
    "dev:save:apple": "node bin/dev.mjs --save-specialization apple",
    "dev:diagnostics": "node bin/dev.mjs --diagnostics",
    "dev:probe": "node bin/dev.mjs --probe-runtime",
    "dev:continue": "node bin/dev.mjs --continue",
    "dev:resume": "node bin/dev.mjs --resume",
    "dev:help": "node bin/dev.mjs --help",
    "start": "node bin/dev.mjs",
    "diagnostics": "node bin/dev.mjs --diagnostics",
    "smoke": "node scripts/smoke.mjs",
    "setup": "node scripts/maintain.mjs setup",
    "update": "node scripts/maintain.mjs update",
    "rollback": "node scripts/maintain.mjs rollback",
    "lint": "oxlint --fix .; oxfmt ."
  },
  "devDependencies": {
    "oxc-standard": "^1.4.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.83.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
