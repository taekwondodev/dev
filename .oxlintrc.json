{
  "extends": ["./node_modules/oxc-standard/.oxlintrc.json"],
  "jsPlugins": [{ "name": "dev", "specifier": "./scripts/code-policy.ts" }],
  "rules": { "dev/no-source-comments": "error" },
  "overrides": [
    {
      "files": ["**/*.ts"],
      "rules": {
        "eslint/new-cap": "off",
        "unicorn/throw-new-error": "off",
        "eslint/no-underscore-dangle": ["warn", { "allow": ["_tag"] }]
      }
    }
  ]
}
